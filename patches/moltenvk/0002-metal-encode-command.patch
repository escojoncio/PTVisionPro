+#pragma mark -
+#pragma mark MVKCmdEncodeMetal
+
+VkResult MVKCmdEncodeMetal::setContent(MVKCommandBuffer* cmdBuff, void (*callback)(void*, void*), const void* pData, uint32_t dataSize) {
+	if (!callback || dataSize > 1024 || (dataSize && !pData)) { return VK_ERROR_INITIALIZATION_FAILED; }
+	_callback = callback;
+	_data.clear();
+	const uint8_t* bytes = (const uint8_t*)pData;
+	for (uint32_t i = 0; i < dataSize; i++) { _data.push_back(bytes[i]); }
+	return VK_SUCCESS;
+}
+
+void MVKCmdEncodeMetal::encode(MVKCommandEncoder* cmdEncoder) {
+	cmdEncoder->endCurrentMetalEncoding();
+	_callback(_data.empty() ? nullptr : _data.data(), (void*)cmdEncoder->_mtlCmdBuffer);
+}
