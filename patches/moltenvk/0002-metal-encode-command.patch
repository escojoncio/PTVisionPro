+#pragma mark -
+#pragma mark Metal work inside a Vulkan command buffer
+
+/**
+ * MoltenVK private command: app-encoded Metal work at a point of a Vulkan command buffer.
+ *
+ * When the command buffer is encoded, MoltenVK ends its current Metal encoder (outside a render
+ * pass only) and calls callback(data, mtlCommandBuffer), where mtlCommandBuffer is the
+ * id<MTLCommandBuffer> the surrounding Vulkan commands are encoded into. The callback encodes its
+ * own work (e.g. a MetalFX effect) on it and returns; the following Vulkan commands go into new
+ * encoders after it. The dataSize bytes at pData are copied into the command (at most 1024).
+ * The resources it touches should be hazard-tracked (MoltenVK's defaults) or fenced by the app.
+ */
+typedef void (*PFN_vkMetalEncodeCallbackMVK)(void* pData, void* mtlCommandBuffer);
+typedef void (VKAPI_PTR *PFN_vkCmdEncodeMetalMVK)(VkCommandBuffer commandBuffer, PFN_vkMetalEncodeCallbackMVK callback,
+												   const void* pData, uint32_t dataSize);
+
+#ifndef VK_NO_PROTOTYPES
+VKAPI_ATTR void VKAPI_CALL vkCmdEncodeMetalMVK(VkCommandBuffer commandBuffer, PFN_vkMetalEncodeCallbackMVK callback,
+												const void* pData, uint32_t dataSize);
+#endif
