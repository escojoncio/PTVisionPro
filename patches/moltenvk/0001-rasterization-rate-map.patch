@@ -452,6 +452,30 @@ typedef enum {
 typedef uint32_t MVKMSLSPIRVHeader;
 
 
+
+#pragma mark -
+#pragma mark Rasterization rate map (variable rasterization rate) for dynamic rendering
+
+/**
+ * MoltenVK private extension: Metal variable rasterization rate in Vulkan dynamic rendering.
+ *
+ * Chain a VkRenderingRasterizationRateMapMVK to the pNext of the VkRenderingInfo given to
+ * vkCmdBeginRendering() and the Metal render passes of that rendering use the given
+ * MTLRasterizationRateMap (MTLRenderPassDescriptor.rasterizationRateMap). Its attachments are
+ * then the map's physical size (physicalSizeForLayer:0), which is also the render area to give,
+ * while viewports and scissors are in the map's screen (logical) coordinates, as Metal expects.
+ *
+ * The map is not retained: the app keeps it alive until the command buffer has completed.
+ * In fragment shaders the position is physical; attributes interpolate in screen space.
+ */
+#define VK_STRUCTURE_TYPE_RENDERING_RASTERIZATION_RATE_MAP_MVK ((VkStructureType)1297501008)
+
+typedef struct VkRenderingRasterizationRateMapMVK {
+	VkStructureType sType;                 /**< VK_STRUCTURE_TYPE_RENDERING_RASTERIZATION_RATE_MAP_MVK */
+	const void* pNext;
+	void* mtlRasterizationRateMap;         /**< An id<MTLRasterizationRateMap>, or NULL for none. */
+} VkRenderingRasterizationRateMapMVK;
+
 #ifdef __cplusplus
 }
 #endif	//  __cplusplus
