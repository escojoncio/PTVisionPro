diff --git a/shaders/common.glsl b/shaders/common.glsl
index 3b70a46..669e071 100644
--- a/shaders/common.glsl
+++ b/shaders/common.glsl
@@ -13,6 +13,7 @@ struct View {
     vec4 jitter;
     vec4 temporal;
     vec4 dominant_light;
+    vec4 vrr;
 };
 
 struct Light {
@@ -101,6 +102,7 @@ layout(set = 1, binding = 4) uniform texture3D lut2_image;
 #define RES_LUT1 24
 #define RES_MATERIAL 25
 #define RES_DITHER 26
+#define RES_VRR_MAP 35
 #define RES_COLOR_LUT 27
 #define RES_COLOR_LUT_PREV 28
 #define RES_NOISE 29
@@ -196,7 +198,40 @@ vec3 ViewPosition(View v, vec2 ndc, float depth) {
     return vec3(ndc * v.projection_param.xy * z, z);
 }
 
+/* Variable rasterization rate (visionOS): the view's scene targets hold physical pixels of a logical
+   picture (v.vrr). Each axis maps on its own through a table (RES_VRR_MAP, a value per whole pixel,
+   linear between): rows vrr.y + 0, 1 physical x, y to logical; + 2, 3 logical x, y to physical. */
+float VrrTable(float row, float x) {
+    int width = textureSize(sampler2D(images[RES_VRR_MAP], samplers[SMP_POINT_CLAMP]), 0).x;
+    float c = clamp(x, 0.0, float(width - 1));
+    int i = min(int(c), width - 2);
+    float a = texelFetch(sampler2D(images[RES_VRR_MAP], samplers[SMP_POINT_CLAMP]), ivec2(i, int(row)), 0).x;
+    float b = texelFetch(sampler2D(images[RES_VRR_MAP], samplers[SMP_POINT_CLAMP]), ivec2(i + 1, int(row)), 0).x;
+    return mix(a, b, c - float(i));
+}
+
+/* A physical pixel position of the view's targets as a logical one (unchanged without the rate map). */
+vec2 VrrLogicalPixel(View v, vec2 physical) {
+    if (!(v.vrr.x > 0.5)) return physical;
+    return vec2(VrrTable(v.vrr.y, physical.x), VrrTable(v.vrr.y + 1.0, physical.y));
+}
+
+/* A uv of the view's targets (physical) as a uv of the logical picture, and back. */
+vec2 VrrLogicalUv(View v, vec2 uv) {
+    if (!(v.vrr.x > 0.5)) return uv;
+    return VrrLogicalPixel(v, uv * v.viewport.xy) / v.vrr.zw;
+}
+
+vec2 VrrPhysicalUv(View v, vec2 uv) {
+    if (!(v.vrr.x > 0.5)) return uv;
+    vec2 logical = uv * v.vrr.zw;
+    return vec2(VrrTable(v.vrr.y + 2.0, logical.x), VrrTable(v.vrr.y + 3.0, logical.y)) * v.viewport.zw;
+}
+
 vec2 PixelNdc(View v, vec2 frag) {
+    if (v.vrr.x > 0.5) {
+        return VrrLogicalPixel(v, frag) / v.vrr.zw * 2.0 - 1.0 - v.jitter.xy;
+    }
     return frag * v.viewport.zw * 2.0 - 1.0 - v.jitter.xy;
 }
 
