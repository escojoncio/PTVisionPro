+    LogInfo("vr: dynamic resolution {:.0f}% -> {:.0f}%: eyes drawn at {}x{} (GPU {:.1f} ms a frame for a budget of {:.1f} ms)", previous * 100.0f,
+            scale * 100.0f, size.x, size.y, average, budget);
+}
