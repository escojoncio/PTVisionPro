+            vec2 logical = vec2(t) * 2.0 + 0.5;
+            ivec2 at = clamp(ivec2(VrrPhysicalUv(v, logical / v.vrr.zw) * v.viewport.xy), ivec2(0), full_size - 1);
+            float d = ImgFetch(IMG_DEPTH, at).x;
