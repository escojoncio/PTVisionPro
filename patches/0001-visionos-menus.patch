+bool VrPlay::PrepareInsets(Stereo& out) {
+    float center = 0.0f;
+    if (!host_.InsetWanted(center) || render_size_.x == 0 || render_size_.y == 0) return false;
+    if (!host_.EnsureInsetImages({render_size_.x, render_size_.y})) return false;
+    // The same pixel size as the wide view (the renderer keeps its targets), over `center` of
+    // its field: as many times denser. (The inset images stay at the full size; a smaller
+    // drawing is enlarged into them, as for the eyes.)
+    const float aspect = static_cast<float>(out.render.width) / static_cast<float>(std::max(out.render.height, 1u));
+    // `center` of the wide view's field across (its pixels as many times denser), around the
+    // eye's forward axis, kept inside both eyes' wide fields.
+    float tan_y = std::clamp(center, 0.2f, 0.8f) * frusta_[0].tan_y;
+    for (int i = 0; i < 2; ++i) {
+        const glm::vec2 c = frusta_[i].center;
+        const float room_x = std::min(c.x + frusta_[i].tan_x, frusta_[i].tan_x - c.x);
+        const float room_y = std::min(c.y + frusta_[i].tan_y, frusta_[i].tan_y - c.y);
+        tan_y = std::min({tan_y, 0.98f * room_y, 0.98f * room_x / aspect});
+    }
+    const float tan_x = tan_y * aspect;
+    out.inset_tangents = glm::vec4(-tan_x, tan_x, tan_y, -tan_y);
+    for (int i = 0; i < 2; ++i) {
+        // The inset's field in its wide view's image (its centre is tangent 0; image y is down).
+        const xr::EyeFrustum& f = frusta_[i];
+        out.inset_share[i] = glm::vec4(tan_x / f.tan_x, tan_y / f.tan_y, -f.center.x / (2.0f * f.tan_x), f.center.y / (2.0f * f.tan_y));
+    }
+    for (int i = 0; i < 2; ++i) {
+        out.insets[i] = out.eyes[i];
+        out.insets[i].fov_y = 2.0f * std::atan(tan_y);
+        out.insets[i].offset = glm::vec2(0.0f);  // centred on the eye's axis
+        xr::Swapchain& sc = host_.InsetSwapchain(i);
+        if (!host_.Acquire(sc)) {
+            if (i == 1) host_.Release(host_.InsetSwapchain(0));
+            return false;
+        }
+        XrTarget& t = out.inset_targets[i];
+        t.image = sc.images[sc.index];
+        t.view = sc.views[sc.index];
+        t.format = sc.format;
+        t.extent = sc.extent;
+        t.rect = glm::vec4(0.0f, 0.0f, 1.0f, 1.0f);
+    }
     return true;
 }
 
+glm::uvec2 VrPlay::DrawSize() const {
+    if (dyn_scale_ >= 0.999f) return render_size_;
+    auto scaled = [&](uint32_t v) { return std::max(16u, 2u * static_cast<uint32_t>(std::lround(static_cast<float>(v) * dyn_scale_ * 0.5f))); };
+    return {scaled(render_size_.x), scaled(render_size_.y)};
+}
