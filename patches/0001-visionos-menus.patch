+// The size to draw each eye's own field at (OwnFrustumFor): the eye image's pixels per tangent
+// over the field itself, the larger of the two eyes, rounded to even numbers.
+inline glm::uvec2 OwnRenderSize(const glm::vec4 tangents[2], glm::uvec2 swapchain) {
+    float density = 0.0f;
+    float width = 0.0f;
+    float height = 0.0f;
+    for (int i = 0; i < 2; ++i) {
+        const float across = std::max(tangents[i].y - tangents[i].x, 1.0e-3f);
+        const float down = std::max(tangents[i].z - tangents[i].w, 1.0e-3f);
+        density = std::max({density, static_cast<float>(swapchain.x) / across, static_cast<float>(swapchain.y) / down});
+        width = std::max(width, across);
+        height = std::max(height, down);
+    }
+    auto even = [](float v) { return std::clamp(2u * static_cast<uint32_t>(std::ceil(v * 0.5f)), 16u, 8192u); };
