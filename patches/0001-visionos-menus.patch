+void SceneRenderer::LabelHook(void* user, VkCommandBuffer cmd, bool begin, const char* name) {
+    SceneRenderer& r = *static_cast<SceneRenderer*>(user);
+    FrameSlot* slot = r.label_slot_;
+    if (!slot || !slot->label_queries || cmd != r.label_cmd_) return;
+    if (begin) {
+        size_t open = 0;
+        for (size_t i : r.label_stack_) open += i != SIZE_MAX ? 1 : 0;
+        if (slot->label_count + 2 + open > kLabelQueries) {
+            r.label_stack_.push_back(SIZE_MAX);
+            return;
+        }
+        FrameSlot::LabelSpan span;
+        span.name = r.label_stack_.empty() || r.label_stack_.back() == SIZE_MAX ? r.label_prefix_ + (name ? name : "?")
+                                                                               : slot->label_spans[r.label_stack_.back()].name + "/" + (name ? name : "?");
+        span.begin = slot->label_count++;
+        vkCmdWriteTimestamp2(cmd, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, slot->label_queries, span.begin);
+        r.label_stack_.push_back(slot->label_spans.size());
+        slot->label_spans.push_back(std::move(span));
+        return;
+    }
+    if (r.label_stack_.empty()) return;
+    const size_t index = r.label_stack_.back();
+    r.label_stack_.pop_back();
+    if (index == SIZE_MAX || slot->label_count >= kLabelQueries) return;
+    FrameSlot::LabelSpan& span = slot->label_spans[index];
+    span.end = slot->label_count++;
+    vkCmdWriteTimestamp2(cmd, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, slot->label_queries, span.end);
+}
+
+void SceneRenderer::ReadLabelTimes(FrameSlot& slot) {
+    slot.label_timed = false;
+    if (!slot.label_queries || slot.label_count == 0) return;
+    std::vector<uint64_t> stamps(slot.label_count, 0);
+    if (vkGetQueryPoolResults(device_, slot.label_queries, 0, slot.label_count, stamps.size() * sizeof(uint64_t), stamps.data(), sizeof(uint64_t),
+                              VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+        return;
+    }
+    const double period = renderer_->Context().properties.limits.timestampPeriod * 1.0e-6;
+    for (const FrameSlot::LabelSpan& span : slot.label_spans) {
+        if (span.end <= span.begin || span.end >= slot.label_count || stamps[span.end] < stamps[span.begin]) continue;
+        auto& sum = label_sums_[span.name];
+        sum.first += static_cast<double>(stamps[span.end] - stamps[span.begin]) * period;
+        sum.second += 1;
+    }
+    ++label_renders_;
+    ++label_class_renders_[slot.label_class];
+    const auto now = std::chrono::steady_clock::now();
+    if (label_since_ == std::chrono::steady_clock::time_point{}) label_since_ = now;
+    if (now - label_since_ < std::chrono::seconds(10) || label_renders_ == 0) return;
+    std::vector<std::pair<std::string, double>> rows;
+    for (const auto& [name, sum] : label_sums_) {
+        // Averaged over the timed views of the same kind (the prefix up to the first '/').
+        const size_t cut = name.find('/');
+        const std::string kind = cut == std::string::npos ? std::string() : name.substr(0, cut + 1);
+        const auto renders = label_class_renders_.find(label_class_renders_.contains(kind) ? kind : std::string());
+        const double n = renders != label_class_renders_.end() && renders->second ? static_cast<double>(renders->second)
+                                                                                    : static_cast<double>(label_renders_);
+        rows.emplace_back(name, sum.first / n);
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+    std::string line;
+    for (size_t i = 0; i < rows.size() && i < 24; ++i) {
+        if (rows[i].second < 0.05) break;
+        line += std::format("{}{} {:.2f}", i ? ", " : "", rows[i].first, rows[i].second);
+    }
+    LogInfo("gpu labels (ms per view, {} timed views, {}x{}): {}", label_renders_, extent_.width, extent_.height, line);
+    label_sums_.clear();
+    label_class_renders_.clear();
+    label_renders_ = 0;
+    label_since_ = now;
+}
