+void VrPlay::ReportGpu(float frame_gpu_ms) {
+    constexpr float kMinScale = 0.5f;
+    constexpr float kStep = 0.05f;
+    const float budget = host_.GpuBudgetMs();
+    const auto now = std::chrono::steady_clock::now();
+    if (budget <= 0.0f) {
+        // Off (or not known): the image size chosen in the settings.
+        if (dyn_scale_ < 1.0f) {
+            dyn_scale_ = 1.0f;
+            LogInfo("vr: dynamic resolution off, eyes drawn at {}x{}", render_size_.x, render_size_.y);
+        }
+        dyn_sum_ = 0.0;
+        dyn_samples_ = 0;
+        dyn_last_ = {};
+        return;
+    }
+    // A gap (a menu on the virtual screen, a pause): what was measured before it is old.
+    if (dyn_last_ == std::chrono::steady_clock::time_point{} || now - dyn_last_ > std::chrono::milliseconds(500)) {
+        dyn_sum_ = 0.0;
+        dyn_samples_ = 0;
+        dyn_since_ = now;
+    }
+    dyn_last_ = now;
+    if (dyn_settle_ > 0) {
+        --dyn_settle_;
+        dyn_since_ = now;
+        return;
+    }
+    if (!(frame_gpu_ms > 0.0f) || frame_gpu_ms > 1000.0f) return;
+    if (dyn_samples_ == 0) dyn_since_ = now;
+    dyn_sum_ += frame_gpu_ms;
+    ++dyn_samples_;
+    // A decision a second at most, on a second of frames; a change at most every two seconds
+    // (each one makes the renderer's targets again).
+    if (dyn_samples_ < 20 || now - dyn_since_ < std::chrono::seconds(1)) return;
+    const float average = static_cast<float>(dyn_sum_ / dyn_samples_);
+    dyn_sum_ = 0.0;
+    dyn_samples_ = 0;
+    if (dyn_changed_ != std::chrono::steady_clock::time_point{} && now - dyn_changed_ < std::chrono::seconds(2)) return;
+    float scale = dyn_scale_;
+    if (average > budget * 1.03f) {
+        // The cost goes with the pixels, the square of the scale; part of it (shadows) does not,
+        // so this falls a little short and the next second takes the rest.
+        const float wanted = dyn_scale_ * std::sqrt(budget * 0.95f / average);
+        scale = std::max({kMinScale, dyn_scale_ - 0.15f, std::floor(wanted / kStep + 1.0e-3f) * kStep});
+    } else if (average < budget * 0.80f) {
+        scale = std::min(1.0f, dyn_scale_ + kStep);
+    }
+    if (std::abs(scale - dyn_scale_) < 1.0e-3f) return;
+    const float previous = dyn_scale_;
+    dyn_scale_ = scale;
+    dyn_changed_ = now;
+    dyn_settle_ = 8;
