diff --git a/MoltenVK/MoltenVK/Commands/MVKCmdRendering.mm b/MoltenVK/MoltenVK/Commands/MVKCmdRendering.mm
index f04a56e..d1fc373 100644
--- a/MoltenVK/MoltenVK/Commands/MVKCmdRendering.mm
+++ b/MoltenVK/MoltenVK/Commands/MVKCmdRendering.mm
@@ -152,11 +152,19 @@ VkResult MVKCmdBeginRendering<N>::setContent(MVKCommandBuffer* cmdBuff,
 
 	cmdBuff->_currentSubpassInfo.beginRendering(pRenderingInfo->viewMask);
 
+	_mtlRasterizationRateMap = nil;
+	for (const auto* next = (const VkBaseInStructure*)pRenderingInfo->pNext; next; next = next->pNext) {
+		if (next->sType == VK_STRUCTURE_TYPE_RENDERING_RASTERIZATION_RATE_MAP_MVK) {
+			_mtlRasterizationRateMap = (id<MTLRasterizationRateMap>)((const VkRenderingRasterizationRateMapMVK*)next)->mtlRasterizationRateMap;
+		}
+	}
+
 	return VK_SUCCESS;
 }
 
 template <size_t N>
 void MVKCmdBeginRendering<N>::encode(MVKCommandEncoder* cmdEncoder) {
+	cmdEncoder->_mtlRasterizationRateMap = _mtlRasterizationRateMap;
 	cmdEncoder->beginRendering(this, &_renderingInfo);
 }
 
