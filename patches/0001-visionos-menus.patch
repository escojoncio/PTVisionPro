+    const double period = renderer_->Context().properties.limits.timestampPeriod * 1.0e-6;
+    for (const FrameSlot::LabelSpan& span : slot.label_spans) {
+        if (span.end <= span.begin || span.end >= slot.label_count || stamps[span.end] < stamps[span.begin]) continue;
+        auto& sum = label_sums_[span.name];
+        sum.first += static_cast<double>(stamps[span.end] - stamps[span.begin]) * period;
+        sum.second += 1;
+    }
+    ++label_renders_;
+    ++label_class_renders_[slot.label_class];
+    const auto now = std::chrono::steady_clock::now();
+    if (label_since_ == std::chrono::steady_clock::time_point{}) label_since_ = now;
