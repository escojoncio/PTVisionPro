+// The size to draw each eye's own field at (OwnFrustumFor): the eye image's pixels per tangent
+// over the field itself, the larger of the two eyes, rounded to even numbers.
+inline glm::uvec2 OwnRenderSize(const glm::vec4 tangents[2], glm::uvec2 swapchain) {
+    float density = 0.0f;
+    float width = 0.0f;
+    float height = 0.0f;
+    for (int i = 0; i < 2; ++i) {
+        const float across = std::max(tangents[i].y - tangents[i].x, 1.0e-3f);
+        const float down = std::max(tangents[i].z - tangents[i].w, 1.0e-3f);
+        density = std::max({density, static_cast<float>(swapchain.x) / across, static_cast<float>(swapchain.y) / down});
+        width = std::max(width, across);
+        height = std::max(height, down);
+    }
+    auto even = [](float v) { return std::clamp(2u * static_cast<uint32_t>(std::ceil(v * 0.5f)), 16u, 8192u); };
+    return {even(width * density), even(height * density)};
+}
+
+// An eye's own, off-centre field (what a headset's runtime hands out), drawn at `render_size`:
+// nothing outside it is drawn. If the proportions differ a little from the field's, the field
+// grows around its centre in the short direction (the eye image takes `rect` of the drawing).
+inline EyeFrustum OwnFrustumFor(const glm::vec4& tangents, glm::uvec2 render_size) {
+    EyeFrustum f;
+    const float aspect = static_cast<float>(render_size.x) / static_cast<float>(std::max(render_size.y, 1u));
+    float half_x = std::max(tangents.y - tangents.x, 1.0e-3f) * 0.5f;
+    float half_y = std::max(tangents.z - tangents.w, 1.0e-3f) * 0.5f;
+    if (half_x < half_y * aspect) {
+        half_x = half_y * aspect;
+    } else {
+        half_y = half_x / aspect;
+    }
+    f.center = glm::vec2((tangents.x + tangents.y) * 0.5f, (tangents.z + tangents.w) * 0.5f);
+    f.tan_x = half_x;
+    f.tan_y = half_y;
+    f.fov_y = 2.0f * std::atan(half_y);
+    f.offset = glm::vec2(-f.center.x / half_x, f.center.y / half_y);
+    const float left = f.center.x - half_x;
+    const float top = f.center.y + half_y;
+    f.rect.x = (tangents.x - left) / (2.0f * half_x);
+    f.rect.z = (tangents.y - tangents.x) / (2.0f * half_x);
+    f.rect.y = (top - tangents.z) / (2.0f * half_y);
+    f.rect.w = (tangents.z - tangents.w) / (2.0f * half_y);
+    return f;
+}
