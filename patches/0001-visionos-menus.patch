+inline EyeFrustum OwnFrustumFor(const glm::vec4& tangents, glm::uvec2 render_size) {
+    EyeFrustum f;
+    const float aspect = static_cast<float>(render_size.x) / static_cast<float>(std::max(render_size.y, 1u));
+    float half_x = std::max(tangents.y - tangents.x, 1.0e-3f) * 0.5f;
+    float half_y = std::max(tangents.z - tangents.w, 1.0e-3f) * 0.5f;
+    if (half_x < half_y * aspect) {
+        half_x = half_y * aspect;
+    } else {
+        half_y = half_x / aspect;
+    }
+    f.center = glm::vec2((tangents.x + tangents.y) * 0.5f, (tangents.z + tangents.w) * 0.5f);
+    f.tan_x = half_x;
+    f.tan_y = half_y;
+    f.fov_y = 2.0f * std::atan(half_y);
+    f.offset = glm::vec2(-f.center.x / half_x, f.center.y / half_y);
+    const float left = f.center.x - half_x;
+    const float top = f.center.y + half_y;
+    f.rect.x = (tangents.x - left) / (2.0f * half_x);
+    f.rect.z = (tangents.y - tangents.x) / (2.0f * half_x);
+    f.rect.y = (top - tangents.z) / (2.0f * half_y);
+    f.rect.w = (tangents.z - tangents.w) / (2.0f * half_y);
+    return f;
