+// Native HDR for a headset view (EDR): the gain above SDR white for the composition, written to the
+// eye image's alpha as 2 - gain (1: none; xr_host_visionos.mm SceneLight). As upstream 1.0.3/1.0.4
+// (hdr_boost.frag): the light is the strongest channel of the scene as the tonemap sees it, flare
+// and bloom included (lamps, the flashlight and their glow rise above white together), rolled off
+// smoothly to the peak (a Hermite shoulder: no clip); the gain is one factor for the whole pixel (the
+// hue stays: no cyan bulbs) and only where the picture shown is near white (dark tones untouched).
+// Needs common.glsl.
+const float kVrHdrSourceWhite = 3.0;
+
+float VrHdrShoulder(float m, float ratio) {
+    if (m <= 1.0 || ratio <= 1.001) {
+        return min(m, 1.0);
+    }
+    float width = min(kVrHdrSourceWhite - 1.0, 2.97 * (ratio - 1.0));
+    if (m >= 1.0 + width) {
+        return ratio;
+    }
+    float t = (m - 1.0) / width;
+    float t2 = t * t;
+    float t3 = t2 * t;
+    return (1.0 - 3.0 * t2 + 2.0 * t3) + (t - 2.0 * t2 + t3) * width + (3.0 * t2 - 2.0 * t3) * ratio;
+}
+
+// p: the pixel in IMG_HDR (and IMG_FLARE); bloom_uv: where the bloom is read (bloom_on 0: none);
+// exposure: the tonemap's f0.z; peak: the brightest, times SDR white (1 to 2); shown: the
+// picture's colour as displayed (sRGB encoded, 0 to 1).
+float VrHdrAlpha(ivec2 p, vec2 bloom_uv, float bloom_on, float exposure, float peak, vec3 shown) {
+    float ratio = min(peak, 2.0);
+    vec3 scene = ImgFetch(IMG_HDR, p).rgb * exposure;
+    scene = mix(scene, vec3(0.0), isnan(scene));
+    scene = clamp(scene, vec3(0.0), vec3(1.0e4));
+    vec3 x = SrgbEncode(scene) + max(ImgFetch(IMG_FLARE, p).rgb, vec3(0.0));
+    vec3 x2 = x * x;
+    vec3 bloom = bloom_on > 0.0 ? min(vec3(0.5), Img(IMG_BLOOM_SUM, SMP_LINEAR_CLAMP, bloom_uv + 0.5 / ImgSize(IMG_BLOOM_SUM)).rgb) : vec3(0.0);
+    vec3 encoded = sqrt(x2 + bloom * max(1.0 - x2, 0.0));
+    float light = pow(max(encoded.r, max(encoded.g, encoded.b)), 2.2);
+    float boost = max(VrHdrShoulder(light, ratio), 1.0) - 1.0;
+    float near_white = smoothstep(0.4, 0.8, max(shown.r, max(shown.g, shown.b)));
+    return 2.0 - clamp(1.0 + boost * near_white, 1.0, ratio);
+}
