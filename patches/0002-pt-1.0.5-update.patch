+void Game::LogModInspect(const Camera& camera) {
+    const glm::vec3 origin = camera.position;
+    const glm::vec3 dir = camera.Forward();
+    float best = 1e30f;
+    const Stage* best_stage = nullptr;
+    const Stage::Draw* best_draw = nullptr;
+    stages_.ForEachStage(
