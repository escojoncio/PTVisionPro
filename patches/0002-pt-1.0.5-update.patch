+    Bc3UnormBlock = 137,
+    Bc3SrgbBlock = 138,
+    Bc4UnormBlock = 139,
+    Bc4SnormBlock = 140,
+    Bc5UnormBlock = 141,
+    Bc5SnormBlock = 142,
+    Bc6hUfloatBlock = 143,
+    Bc6hSfloatBlock = 144,
